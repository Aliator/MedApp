# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# Dev-only admin account the screenshots log in with (needs the Admin role for /admin/users).
PARITY_USERNAME=
PARITY_PASSWORD=

# Blazor client (MedApp.Client, https launch profile) and the API it calls.
# The client's HttpClient is hard-coded to the API's https port, which the AppHost keeps fixed.
BLAZOR_URL=https://localhost:7292
BLAZOR_API_URL=https://localhost:7038

# React app (MedApp.Web). Leave empty until it exists; its screens then show as "missing" in the report.
# The React app proxies /api to the API, so no separate API URL is needed.
WEB_URL=
