# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# The local test login the screenshots sign in with: the only Admin account, created by medapp-dev
# (ensure_test_admin / reset_demo_data). It needs the Admin role for /admin/users. Local dev only.
PARITY_USERNAME=admin
PARITY_PASSWORD=admin

# React app (MedApp.Web), on the fixed port the AppHost gives it.
# It proxies /api to the API, so no separate API URL is needed.
WEB_URL=http://localhost:5173

# Deprecated Blazor client (MedApp.Client.Deprecated). Leave empty: the AppHost no longer runs it. To capture it
# again, run it by hand (see its README.md) and set these to its https URL and the API it calls.
BLAZOR_URL=
BLAZOR_API_URL=
