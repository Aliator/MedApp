@if (IsVisible)
{
    <div class="modal-overlay" @onclick="OnCancel">
        <div class="modal-container @(IsDanger ? "modal-danger" : "")" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@Title</h3>
                <button class="modal-close" @onclick="OnCancel" aria-label="Close">
                    <Icon Type="IconType.Cancel" Size="20" />
                </button>
            </div>

            <div class="modal-body">
                <div class="confirmation-icon @(IsDanger ? "confirmation-icon-danger" : "confirmation-icon-save")">
                    @if (CustomIcon != null)
                    {
                        @CustomIcon
                    }
                    else if (IsDanger)
                    {
                        <Icon Type="IconType.Alert" Size="48" />
                    }
                    else
                    {
                        <Icon Type="IconType.Save" Size="48" />
                    }
                </div>
                <p class="modal-text @(IsDanger ? "modal-text-danger" : "")">@Message</p>
                @if (ChildContent != null)
                {
                    @ChildContent
                }
            </div>

            <div class="modal-footer">
                <button class="btn-outline" @onclick="OnCancel" disabled="@IsProcessing">
                    @CancelText
                </button>
                <button class="@(IsDanger ? "btn-danger" : "btn-primary")" @onclick="OnConfirm" disabled="@IsProcessing">
                    @if (IsProcessing)
                    {
                        <span class="spinner-small"></span>
                        <span>@ProcessingText</span>
                    }
                    else
                    {
                        @if (ConfirmIcon != null)
                        {
                            @ConfirmIcon
                        }
                        else if (IsDanger)
                        {
                            <Icon Type="IconType.Delete" Size="18" />
                        }
                        else
                        {
                            <Icon Type="IconType.Check" Size="18" />
                        }
                        <span>@ConfirmText</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
