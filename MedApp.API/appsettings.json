{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "PasswordRequiredLength": 8,
    "RequireDigit": true,
    "RequireLowercase": true,
    "RequireUppercase": true,
    "RequireNonAlphanumeric": false,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 5
  },
  "Activity": {
    "ViewWindowMinutes": 5
  },
  "Retention": {
    "AdultYears": 8,
    "AdultAge": 18,
    "ChildUntilAge": 25,
    "ChildAgedSeventeenUntilAge": 26,
    "MaxKeepYears": 2
  }
}
