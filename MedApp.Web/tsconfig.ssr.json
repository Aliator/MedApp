{
  // The server entry (src/entry-server.tsx) and its test, and the permission catalogue's test (which reads the API's
  // C# source), which run in Node: the app's settings, plus Node's types.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.ssr.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["src/lightDemo.d.ts", "src/fullDemo.d.ts", "src/entry-server.tsx", "src/entry-server.test.tsx", "src/auth/permissionCatalogue.test.ts"],
  "exclude": []
}
