@page "/patients"

<h3>Patients</h3>

@if (!Auth.IsAuthenticated)
{
    <p>Redirecting…</p>
}
else if (_patients is null)
{
    <p>Loading…</p>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Name</th>
            <th>Date of Birth</th>
            <th>Email</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var p in _patients)
        {
            <tr>
                <td>@p.FirstName @p.LastName</td>
                <td>@p.DateOfBirth</td>
                <td>@p.Email</td>
                <td>
                    <button class="table-button" @onclick="() => ViewPatient(p.Id)">
                        View
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <button class="primary-button" @onclick="AddPatient">
        Add patient
    </button>

}