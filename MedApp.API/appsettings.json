{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "PasswordRequiredLength": 8,
    "RequireDigit": true,
    "RequireLowercase": true,
    "RequireUppercase": true,
    "RequireNonAlphanumeric": false,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 5
  },
  "Activity": {
    "ViewWindowMinutes": 5
  },
  "Retention": {
    "AdultYears": 8,
    "AdultAge": 18,
    "ChildUntilAge": 25,
    "ChildAgedSeventeenUntilAge": 26,
    "MaxKeepYears": 2,
    "Classes": {
      "Oncology": 30,
      "Maternity": 25,
      "MentalHealth": 20
    },
    "Operational": {
      "DryRun": true,
      "SessionMonths": 12,
      "SignInEventMonths": 12,
      "NotificationMonths": 6,
      "ExpiredCodeDays": 1
    }
  },
  "Jobs": {
    "Enabled": true
  },
  "Notepad": {
    "KeepDays": 30
  },
  "PatientMessages": {
    "Mode": "Off",
    "SenderName": "MedApp"
  },
  "Reminders": {
    "DaysBefore": 2,
    "MissedMessage": false
  }
}
