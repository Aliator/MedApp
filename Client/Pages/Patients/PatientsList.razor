@page "/patients"
@using MedApp.Client.Auth
@using MedApp.Contracts.Patients.Responses
@inject HttpClient Http
@inject AuthState Auth
@inject NavigationManager Nav

<h3>Patients</h3>

@if (!Auth.IsAuthenticated)
{
    <p>Redirecting…</p>
}
else if (_patients is null)
{
    <p>Loading…</p>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Name</th>
            <th>Date of Birth</th>
            <th>Email</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var p in _patients)
        {
            <tr>
                <td>@p.FirstName @p.LastName</td>
                <td>@p.DateOfBirth</td>
                <td>@p.Email></td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<PatientResponse>? _patients;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        Auth.Apply(Http);

        var response = await Http.GetAsync("api/patients");

        if (!response.IsSuccessStatusCode)
        {
        }

        _patients = await response.Content
            .ReadFromJsonAsync<IReadOnlyList<PatientResponse>>();
    }
}