@page "/patients/{Id:guid}"

<PageTitle>View Patients - MedApp</PageTitle>

<Page Title="View Patients"
      Subtitle="Update patient information"
      ShowBackButton="true"
      BackButtonTitle="Back to patient"
      OnBack="GoBack"
      MaxWidth="900">

    <Content>
        <ViewCard>
            <Sections>
                <ViewSection Title="Personal Information">
                    <ViewGroup Label="First Name">
                        @_patient?.FirstName
                    </ViewGroup>

                    <ViewGroup Label="Last Name">
                        @_patient?.LastName
                    </ViewGroup>

                    <ViewGroup Label="Date of Birth">
                        @_patient?.DateOfBirth.ToString("MMMM dd, yyyy")
                    </ViewGroup>

                    <ViewGroup Label="Age">
                        @if (_patient != null)
                        {
                            @CalculateAge(_patient.DateOfBirth)
                        }
                        years
                    </ViewGroup>
                </ViewSection>

                <ViewSection Title="Contact Information">
                    <ViewGroup Label="Email Address" CssClass="view-group-wide">
                        <a href="mailto:@_patient?.Email" class="link">
                            @_patient?.Email
                        </a>
                    </ViewGroup>
                </ViewSection>

                <ViewSection Title="Record Information">
                    <ViewGroup Label="Patients ID">
                        <span class="mono">@_patient?.Id</span>
                    </ViewGroup>
                </ViewSection>
            </Sections>

            <FooterActions>
                <button class="btn-secondary" @onclick="Edit">
                    <Icon Type="IconType.Edit" Size="16" />
                    Edit Patients
                </button>
            </FooterActions>
        </ViewCard>

    </Content>
</Page>
