<div class="table-clip-wrapper @(_sized ? "" : "table-unsized")" @ref="_wrapperRef">
    <TableCard>
        <table class="data-table" style="@(TableWidth > 0 ? $"width: {TableWidth}px" : "")">
            @if (Widths != null && Widths.Length > 0)
            {
                <colgroup>
                    @foreach (var width in Widths)
                    {
                        <col style="width: @width" />
                    }
                </colgroup>
            }
            <thead>
                <tr>
                    <CascadingValue Name="SortColumn" Value="@SortColumn">
                        <CascadingValue Name="SortAscending" Value="@SortAscending">
                            <CascadingValue Name="OnSort" Value="@OnSort">
                                @Columns
                            </CascadingValue>
                        </CascadingValue>
                    </CascadingValue>
                </tr>
            </thead>
            <tbody>
                @if (IsLoading)
                {
                    @for (var i = 0; i < SkeletonCount; i++)
                    {
                        <tr class="skeleton-row">
                            @for (var j = 0; j < SkeletonColumns; j++)
                            {
                                @if (j == SkeletonColumns - 1 && SkeletonLastColumnAsActions)
                                {
                                    <td>
                                        <div class="skeleton-actions">
                                            @for (var k = 0; k < SkeletonActionButtonCount; k++)
                                            {
                                                <div class="skeleton skeleton-action-btn"></div>
                                            }
                                        </div>
                                    </td>
                                }
                                else if (SkeletonLastColumnAsActions && j == SkeletonColumns - 1)
                                {
                                    <td class="actions-cell">
                                        <div class="action-buttons skeleton-action-buttons">
                                            @for (var k = 0; k < SkeletonActionButtonCount; k++)
                                            {
                                                <div class="skeleton skeleton-action-btn"></div>
                                            }
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td><div class="skeleton skeleton-cell"></div></td>
                                }
                            }
                        </tr>
                    }
                }
                else
                {
                    @Rows
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="100" class="pagination-footer @(!IsLoading && TotalRows > 0 ? "" : "pagination-footer--hidden")">
                        <div class="pagination-inner">
                            <button class="pagination-btn"
                                    @onclick="FirstPage"
                                    disabled="@(CurrentPage <= 1 || IsLoading)"
                                    @onmousedown:preventDefault="true">
                                <Icon Type="IconType.ChevronDoubleLeft" Size="16" />
                            </button>
    
                            <button class="pagination-btn"
                                    @onclick="PrevPage"
                                    disabled="@(CurrentPage <= 1 || IsLoading)"
                                    @onmousedown:preventDefault="true">
                                <Icon Type="IconType.ChevronLeft" Size="16" />
                            </button>
    
                            <span class="pagination-label">
                        Page
                                @if (!IsLoading && _editingPage)
                                {
                                    <input class="pagination-page-input"
                                           type="number"
                                           min="1"
                                           max="@TotalPages"
                                           @bind="_pageInputValue"
                                           @onkeydown="HandlePageInputKey"
                                           @onblur="CommitPageInput"
                                           @ref="_pageInputRef" />
                                }
                                else
                                {
                                    <span class="pagination-page-number"
                                          @ondblclick="@((IsLoading ? null : StartEditingPage)!)">@CurrentPage</span>
                                }
                                of <span class="pagination-page-number pagination-page-number--static">@TotalPages</span>
                    </span>
    
                            <button class="pagination-btn"
                                    @onclick="NextPage"
                                    disabled="@(CurrentPage >= TotalPages || IsLoading)"
                                    @onmousedown:preventDefault="true">
                                <Icon Type="IconType.ChevronRight" Size="16" />
                            </button>
    
                            <button class="pagination-btn"
                                    @onclick="LastPage"
                                    disabled="@(CurrentPage >= TotalPages || IsLoading)"
                                    @onmousedown:preventDefault="true">
                                <Icon Type="IconType.ChevronDoubleRight" Size="16" />
                            </button>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
    </TableCard>
</div>
