<Project>

    <!-- What MedApp.Browser compiles, shared with tools/MedApp.BrowserDb (which builds the demo database natively with the
         same sources and SQLite fit): Infrastructure's portable files, the API's controllers, and, for a project
         other than MedApp.Browser, MedApp.Browser's own files but its entry point. -->
    <PropertyGroup>
        <BrowserSourcesDir>$(MSBuildThisFileDirectory)</BrowserSourcesDir>
        <DefineConstants Condition="Exists('$(BrowserSourcesDir)Data\CompiledModel\MedAppDbContextModel.cs')">$(DefineConstants);BROWSER_COMPILED_MODEL</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(BrowserSourcesDir)..\MedApp.Application\MedApp.Application.csproj" />
        <ProjectReference Include="$(BrowserSourcesDir)..\MedApp.Domain\MedApp.Domain.csproj" />
        <ProjectReference Include="$(BrowserSourcesDir)..\MedApp.Contracts\MedApp.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
        <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
        <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
        <PackageReference Include="Markdig" Version="1.6.0" />
    </ItemGroup>

    <!-- Infrastructure's portable files, compiled as they are. What can't run in the browser is left out, and replaced
         by the stand-ins in MedApp.Browser/Infrastructure. -->
    <ItemGroup>
        <Compile Include="$(BrowserSourcesDir)..\MedApp.Infrastructure\**\*.cs"
                 Exclude="$(BrowserSourcesDir)..\MedApp.Infrastructure\bin\**;$(BrowserSourcesDir)..\MedApp.Infrastructure\obj\**;$(BrowserSourcesDir)..\MedApp.Infrastructure\Migrations\**;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Common\Extensions\ServiceExtensions.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Attachments\AttachmentStorageOptions.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Attachments\BlobFileStore.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Attachments\SkiaThumbnailGenerator.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Attachments\StaleUploadSweeper.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Common\Email\EmailDispatcher.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Common\Email\SmtpEmailTransport.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Common\Identity\DataProtectionKeyCheck.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Common\Identity\PasswordResetTokenProvider.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Data\CalendarLock.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\Letters\SecureEmailLetterTransport.cs;
                          $(BrowserSourcesDir)..\MedApp.Infrastructure\PatientMessages\NotifyPatientMessageTransport.cs"
                 Link="Shared\Infrastructure\%(RecursiveDir)%(Filename)%(Extension)" />
        <EmbeddedResource Include="$(BrowserSourcesDir)..\MedApp.Infrastructure\Common\Identity\Passwords\common-passwords.txt" LogicalName="MedApp.Infrastructure.CommonPasswords.txt" Link="Shared\Infrastructure\common-passwords.txt" />
        <EmbeddedResource Include="$(BrowserSourcesDir)..\MedApp.Infrastructure\Letters\Fonts\*.ttf" LogicalName="MedApp.Infrastructure.LetterFonts.%(Filename)%(Extension)" Link="Shared\Infrastructure\Fonts\%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- The API's controllers, unchanged, against the MVC stand-in in MedApp.Browser/Mvc. -->
    <ItemGroup>
        <Compile Include="$(BrowserSourcesDir)..\MedApp.API\Controllers\*.cs" Exclude="$(BrowserSourcesDir)..\MedApp.API\Controllers\FhirController.cs" Link="Shared\Api\Controllers\%(Filename)%(Extension)" />
        <Compile Include="$(BrowserSourcesDir)..\MedApp.API\Common\Authentication\ClaimsPrincipalExtensions.cs;
                          $(BrowserSourcesDir)..\MedApp.API\Common\Authentication\SessionAuthenticationDefaults.cs;
                          $(BrowserSourcesDir)..\MedApp.API\Common\Authentication\RequirePermissionAttribute.cs;
                          $(BrowserSourcesDir)..\MedApp.API\Common\Authentication\AuthPolicies.cs;
                          $(BrowserSourcesDir)..\MedApp.API\Common\Authentication\ISessionCookieService.cs;
                          $(BrowserSourcesDir)..\MedApp.API\Attachments\AttachmentResponseHeaders.cs;
                          $(BrowserSourcesDir)..\MedApp.API\Middleware\ExceptionHandling.cs"
                 Link="Shared\Api\%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- The API's settings (Identity's rules, retention, notepads, reminders), read as the API reads them. -->
    <ItemGroup>
        <EmbeddedResource Include="$(BrowserSourcesDir)..\MedApp.API\appsettings.json" LogicalName="MedApp.Browser.appsettings.json" Link="Shared\Api\appsettings.json" />
    </ItemGroup>

    <ItemGroup Condition="'$(MSBuildProjectName)' != 'MedApp.Browser'">
        <Compile Include="$(BrowserSourcesDir)**\*.cs"
                 Exclude="$(BrowserSourcesDir)bin\**;$(BrowserSourcesDir)obj\**;$(BrowserSourcesDir)Program.cs"
                 Link="Shared\Browser\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.AspNetCore.Http" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

</Project>
