<Modal IsVisible="@IsVisible"
       Title="@Title"
       OnClose="@OnClose">

    <Body>
    <div class="search-fields">
        @foreach (var field in Fields)
        {
            @if (field.Type == SearchFieldType.Date)
            {
                <DatePickerFormGroup Label="@field.Label"
                                     Required="false"
                                     ShowAge="false"
                                     Value="@field.DateValue"
                                     ValueChanged="@(v => field.DateValue = v)" />
            }
            else
            {
                <FormGroup Label="@field.Label">
                    <input class="form-input"
                           type="text"
                           placeholder="@field.Placeholder"
                           value="@field.Value"
                           @oninput="e => field.Value = e.Value?.ToString() ?? string.Empty" />
                </FormGroup>
            }
        }
    </div>
    </Body>

    <Footer>
        <button class="btn-outline" @onclick="HandleClear">
            Clear
        </button>
        <button class="btn-primary" @onclick="HandleSearch">
            <Icon Type="IconType.Search" Size="16" />
            Search
        </button>
    </Footer>

</Modal>