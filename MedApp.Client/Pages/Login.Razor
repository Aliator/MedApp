@page "/login"

<div class="auth-container">
    <div class="auth-card">
        <h2>Sign in</h2>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-error">@_error</div>
        }

        <input class="auth-input" placeholder="Username" @bind="_username" />
        <input class="auth-input" type="password" placeholder="Password" @bind="_password" />

        <button class="auth-button" @onclick="HandleLogin">
            Login
        </button>
    </div>
</div>