<Project Sdk="Microsoft.NET.Sdk">

    <!-- NuGet audit: a known high (NU1903) or critical (NU1904) vulnerability in any package, direct or
         transitive, fails the build. Moderate and low ones stay warnings. -->
    <PropertyGroup>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>MedApp.Infrastructure</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\MedApp.Application\MedApp.Application.csproj" />
      <ProjectReference Include="..\MedApp.Domain\MedApp.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- The common passwords CommonPasswordValidator refuses (source and licence in its NOTICE.txt). -->
      <EmbeddedResource Include="Common\Identity\Passwords\common-passwords.txt" LogicalName="MedApp.Infrastructure.CommonPasswords.txt" />
      <!-- The font letters are rendered in, Atkinson Hyperlegible (SIL Open Font License; source and licence in its
           NOTICE.txt and OFL.txt): the image has no system fonts. -->
      <EmbeddedResource Include="Letters\Fonts\*.ttf" LogicalName="MedApp.Infrastructure.LetterFonts.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
      <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
      <PackageReference Include="Azure.Identity" Version="1.21.0" />
      <PackageReference Include="MailKit" Version="4.18.2" />
      <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
      <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
      <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
      <!-- Letters' PDFs (MIT licence up to 6.2.x; 6.5.0 and later are AGPL-3.0, so Dependabot ignores them). Fully
           managed: no native library, so the image needs nothing new. -->
      <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
      <!-- Letters' Markdown bodies (BSD-2-Clause licence). -->
      <PackageReference Include="Markdig" Version="1.6.0" />
      <!-- Thumbnails of uploaded images (MIT licence). The Linux build has no dependencies on the image's libraries. -->
      <PackageReference Include="SkiaSharp" Version="3.119.4" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    </ItemGroup>

</Project>
