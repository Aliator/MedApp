@page "/login"

<div class="auth-container">
    <div class="auth-card">
        <div>
            <h2>Sign in</h2>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-error">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                @_error
            </div>
        }

        <form @onsubmit="HandleLogin" @onsubmit:preventDefault>
            <div class="form-group">
                <label class="form-label" for="username">Username</label>
                <input
                    id="username"
                    class="form-input"
                    placeholder="Enter your username"
                    @bind="_username"
                    autocomplete="username"
                    required />
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <input
                    id="password"
                    class="form-input"
                    type="password"
                    placeholder="Enter your password"
                    @bind="_password"
                    autocomplete="current-password"
                    required />
            </div>

            <button type="submit" class="btn-primary">
                Sign in
            </button>

            <button type="button" class="btn-tertiary" @onclick="ShowForgotPassword">
                Forgot password?
            </button>
        </form>
    </div>
</div>

@if (_showForgotPassword)
{
    <div class="modal-overlay" @onclick="HideForgotPassword">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">Reset your password</h3>
                <button class="modal-close" @onclick="HideForgotPassword" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            <div class="modal-body">
                @if (!_resetEmailSent)
                {
                    <p class="modal-text">Enter your email address and we'll send you a link to reset your password.</p>

                    <div class="form-group">
                        <label class="form-label">Email address</label>
                        <input
                            type="email"
                            class="form-input"
                            placeholder="Enter your email"
                            @bind="_resetEmail"
                            autocomplete="email"
                            required />
                    </div>

                    @if (!string.IsNullOrEmpty(_resetError))
                    {
                        <div class="auth-error">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            </svg>
                            @_resetError
                        </div>
                    }
                }
                else
                {
                    <div class="confirmation-icon confirmation-icon-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </div>
                    <p class="modal-text" style="font-weight: 600;">Check your email</p>
                    <p class="modal-text">We've sent a password reset link to <strong>@_resetEmail</strong></p>
                    <p class="modal-text" style="font-size: 0.875rem; color: var(--text-secondary);">
                        If you don't see the email, check your spam folder or try again.
                    </p>
                }
            </div>

            <div class="modal-footer">
                @if (!_resetEmailSent)
                {
                    <button class="btn-outline" @onclick="HideForgotPassword" disabled="@_isSendingReset">
                        Cancel
                    </button>

                    <button class="btn-primary" @onclick="RequestPasswordReset" disabled="@_isSendingReset">
                        @if (_isSendingReset)
                        {
                            <span class="spinner-small"></span>
                            <span>Sending...</span>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                            <span>Send reset link</span>
                        }
                    </button>
                }
                else
                {
                    <button class="btn-primary" @onclick="CloseForgotPassword">
                        Close
                    </button>
                }
            </div>
        </div>
    </div>
}

<style>
    .modal-text {
        text-align: center;
        color: var(--text-primary);
        margin: 0 0 1rem 0;
        line-height: 1.5;
    }

    .confirmation-icon {
        display: flex;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .confirmation-icon-success svg {
        color: var(--success-color, #10b981);
    }
</style>
