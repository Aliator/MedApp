<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- NuGet audit: a known high (NU1903) or critical (NU1904) vulnerability in any package, direct or
         transitive, fails the build. Moderate and low ones stay warnings. -->
    <PropertyGroup>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MedApp.Contracts\MedApp.Contracts.csproj" />
        <ProjectReference Include="..\MedApp.Application\MedApp.Application.csproj" />
        <ProjectReference Include="..\MedApp.Infrastructure\MedApp.Infrastructure.csproj" />
        <ProjectReference Include="..\MedApp.ServiceDefaults\MedApp.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
