@{
    var rootClass = HasSecondary
        ? $"patient-cell{(ShowHoverFullName ? " is-truncated" : "")}"
        : "user-cell";
}

<div class="@rootClass" title="@PrimaryText">
    <div class="@(HasSecondary ? "patient-avatar" : "user-avatar")">
        @AvatarText
    </div>

    <div class="@(HasSecondary ? "patient-info" : "user-info")">
        <div class="@(HasSecondary ? "patient-name" : "user-name")">
            @DisplayPrimaryText
        </div>

        @if (HasSecondary)
        {
            <div class="patient-id">
                @SecondaryText
            </div>
        }
    </div>

    @if (ShowHoverFullName)
    {
        <div class="patient-cell-hover">
            <span class="patient-cell-hover-name">@PrimaryText</span>
        </div>
    }
</div>
