@page "/patients"

<PageTitle>Patients - MedApp</PageTitle>

<Page Title="Patients"
      Subtitle="@GetSubtitle()"
      ShowBackButton="false"
      MaxWidth="1400">

    <HeaderActions>
        <button class="btn-primary" @onclick="AddPatient">
            <Icon Type="IconType.Add" Size="18" />
            Add Patient
        </button>
    </HeaderActions>

    <Content>
        @if (_patients is null)
        {
            <DataTable IsLoading="true" SkeletonRows="8" SkeletonColumns="5">
                <Columns>
                    <th>Patient</th>
                    <th>Date of Birth</th>
                    <th>Age</th>
                    <th>Email</th>
                    <th class="actions-column">Actions</th>
                </Columns>
            </DataTable>
        }
        else if (_patients.Count == 0)
        {
            <EmptyState Title="No patients yet"
                        Description="Get started by adding your first patient to the system."
                        ButtonText="Add Your First Patient">
                <CustomIcon>
                    <Icon Type="IconType.Patients" Size="64"/>
                </CustomIcon>
            </EmptyState>
        }
        else
        {
            <DataTable>
                <Columns>
                    <th>Patient</th>
                    <th>Date of Birth</th>
                    <th>Age</th>
                    <th>Email</th>
                    <th class="actions-column">Actions</th>
                </Columns>
                <Rows>
                    @foreach (var patient in _patients)
                    {
                        <tr @onclick="() => ViewPatient(patient.Id)" class="clickable-row">
                            <td>
                                <AvatarCell AvatarText="@GetInitials(patient.FirstName, patient.LastName)"
                                            PrimaryText="@($"{patient.FirstName} {patient.LastName}")"
                                            SecondaryText="@($"ID: {patient.Id.ToString().Substring(0, 8)}")" />
                            </td>
                            <td>@patient.DateOfBirth.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="age-badge">@CalculateAge(patient.DateOfBirth) yrs</span>
                            </td>
                            <td>
                                <a href="mailto:@patient.Email" class="link" @onclick:stopPropagation="true">
                                    @patient.Email
                                </a>
                            </td>
                            <td class="actions-cell" @onclick:stopPropagation="true">
                                <TableActions>
                                    <button class="btn-table-action btn-view"
                                            @onclick="() => ViewPatient(patient.Id)"
                                            title="View patient">
                                        <Icon Type="IconType.View" Size="16" />
                                        <span class="mobile-hidden">View</span>
                                    </button>

                                    <button class="btn-table-action btn-edit"
                                            @onclick="() => EditPatient(patient.Id)"
                                            title="Edit patient">
                                        <Icon Type="IconType.Edit" Size="16" />
                                        <span class="mobile-hidden">Edit</span>
                                    </button>
                                </TableActions>
                            </td>
                        </tr>
                    }
                </Rows>
            </DataTable>
        }
    </Content>
</Page>
