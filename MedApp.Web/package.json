{
  "name": "medapp-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/server.mjs --dev",
    "dev:client": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/ssr && node -e \"require('fs').copyFileSync('server/server.mjs','dist/ssr/server.mjs')\"",
    "start": "node dist/ssr/server.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "gen:api": "openapi-typescript http://localhost:5173/swagger/v1/swagger.json -o src/api/schema.d.ts",
    "theme:build": "astryx theme build src/themes/medapp/medappTheme.ts",
    "theme:check": "astryx theme build src/themes/medapp/medappTheme.ts --check"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.15",
    "@astryxdesign/richtext": "0.7.15",
    "@astryxdesign/theme-stone": "0.7.15",
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "@lexical/code": "0.52.0",
    "@lexical/extension": "0.52.0",
    "@lexical/headless": "0.52.0",
    "@lexical/html": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@microsoft/signalr": "10.0.11",
    "@remixicon/react": "^4.9.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "lexical": "0.52.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.15",
    "@eslint/js": "^10.0.1",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@astryxdesign/cli": false,
    "@astryxdesign/core": false
  },
  "overrides": {
    "happy-dom": "21.0.4"
  }
}
