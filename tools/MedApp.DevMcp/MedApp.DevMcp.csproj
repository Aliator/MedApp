<Project Sdk="Microsoft.NET.Sdk">

    <!-- NuGet audit: a known high (NU1903) or critical (NU1904) vulnerability in any package, direct or
         transitive, fails the build. Moderate and low ones stay warnings. -->
    <PropertyGroup>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

  <!-- Development-only MCP server for managing local accounts and app state while MedApp.Web is built.
       Never deployed; refuses to start against anything but a local database. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MedApp.DevMcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MedApp.Application\MedApp.Application.csproj" />
    <ProjectReference Include="..\..\MedApp.Infrastructure\MedApp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="devmcp.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
