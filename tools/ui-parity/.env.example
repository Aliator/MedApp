# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# The local logins these tools sign in with: synthetic accounts just for them. Not your own: each screen sets its
# account's saved settings, which the server renders pages with. Local dev only.

# The admin, for setup, accounts and the read-only view (it needs the Admin role for /admin/users).
# Create it with medapp-dev: create_user, username dev-parity, roles ["Admin"].
PARITY_USERNAME=dev-parity
PARITY_PASSWORD=

# Members of staff, for the screens that need clinical access (admins are read only, and records sit behind team
# walls): Dermatology's clinician (needed) and the lab's pathologist (optional: the lab screens skip without it).
# Create both with medapp-dev: ensure_test_staff, prefix "dev-parity", and a password of your choosing. Run it again
# after reset_demo_data, which remakes the teams.
PARITY_STAFF_USERNAME=dev-parity-clinician
PARITY_STAFF_PASSWORD=
PARITY_LAB_USERNAME=dev-parity-lab
PARITY_LAB_PASSWORD=

# React app (MedApp.Web), on the fixed port the AppHost gives it.
# It proxies /api to the API, so no separate API URL is needed.
WEB_URL=http://localhost:5173

# Deprecated Blazor client (MedApp.Client.Deprecated). Leave empty: the AppHost no longer runs it. To capture it
# again, run it by hand (see its README.md) and set these to its https URL and the API it calls.
BLAZOR_URL=
BLAZOR_API_URL=
