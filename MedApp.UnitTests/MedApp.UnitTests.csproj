<Project Sdk="Microsoft.NET.Sdk">

    <!-- NuGet audit: a known high (NU1903) or critical (NU1904) vulnerability in any package, direct or
         transitive, fails the build. Moderate and low ones stay warnings. -->
    <PropertyGroup>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>MedApp.UnitTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoFixture" Version="4.18.1" />
        <PackageReference Include="AutoFixture.AutoMoq" Version="4.18.1" />
        <PackageReference Include="AutoFixture.NUnit3" Version="4.18.1" />
        <PackageReference Include="coverlet.collector" Version="6.0.4" />
        <PackageReference Include="FluentAssertions" Version="8.11.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="Moq" Version="4.21.0" />
        <PackageReference Include="NUnit" Version="5.0.0" />
        <PackageReference Include="NUnit.Analyzers" Version="3.10.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MedApp.API\MedApp.API.csproj" />
        <ProjectReference Include="..\MedApp.Application\MedApp.Application.csproj" />
        <ProjectReference Include="..\MedApp.Contracts\MedApp.Contracts.csproj" />
        <ProjectReference Include="..\MedApp.Infrastructure\MedApp.Infrastructure.csproj" />
        <!-- The dev MCP tool (not in the solution; CI builds it first): DevMcpServicesTests checks its services resolve. -->
        <ProjectReference Include="..\tools\MedApp.DevMcp\MedApp.DevMcp.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Application\Auth\Roles\" />
      <Folder Include="Application\Auth\Session\Commands\" />
      <Folder Include="Application\Auth\Users\Commands\" />
      <Folder Include="Application\Auth\Users\Queries\" />
    </ItemGroup>

</Project>