<nav class="nav">
    <ul class="nav-list">
        @if (!Auth.IsAuthenticated)
        {
            <li>
                <NavLink href="/login">Login</NavLink>
            </li>
        }
        else
        {
            <li>
                <NavLink href="/">Home</NavLink>
            </li>
            <li>
                <NavLink href="/patients">Patients</NavLink>
            </li>
            @if (Auth.IsAdmin)
            {
                <li>
                    <NavLink href="/admin/users">Users</NavLink>
                </li>
            }
            <li>
                <button class="nav-button" @onclick="Logout">
                    Logout
                </button>
            </li>
        }
    </ul>
</nav>