@page "/login"
@using MedApp.Client.Auth
@using MedApp.Contracts.Auth.Requests
@using MedApp.Contracts.Auth.Responses
@inject HttpClient Http
@inject AuthState Auth
@inject NavigationManager Nav

<div class="auth-container">
    <div class="auth-card">
        <h2>Sign in</h2>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-error">@_error</div>
        }

        <input
            class="auth-input"
            placeholder="Username"
            @bind="_username" />

        <input
            class="auth-input"
            type="password"
            placeholder="Password"
            @bind="_password" />

        <button class="auth-button" @onclick="HandleLogin">
            Login
        </button>
    </div>
</div>

@code {
    private string _username = "";
    private string _password = "";
    private string? _error;

    private async Task HandleLogin()
    {
        _error = null;

        var response = await Http.PostAsJsonAsync(
            "api/auth/login",
            new LoginRequest(_username, _password));

        if (!response.IsSuccessStatusCode)
        {
            _error = "Invalid credentials";
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

        if (result is null)
        {
            _error = "Invalid response";
            return;
        }

        Auth.SetToken(result.AccessToken);
        Auth.Apply(Http);

        Nav.NavigateTo("/patients");
    }
}
