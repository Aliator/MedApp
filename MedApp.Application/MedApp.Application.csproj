<Project Sdk="Microsoft.NET.Sdk">

    <!-- NuGet audit: a known high (NU1903) or critical (NU1904) vulnerability in any package, direct or
         transitive, fails the build. Moderate and low ones stay warnings. -->
    <PropertyGroup>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\MedApp.Contracts\MedApp.Contracts.csproj" />
      <ProjectReference Include="..\MedApp.Domain\MedApp.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FluentValidation" Version="12.2.0" />
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
      <PackageReference Include="MediatR" Version="14.3.0" />
      <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.15" />
      <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Authentication\Roles\" />
      <Folder Include="Authentication\Sessions\Commands\" />
      <Folder Include="Authentication\Users\Commands\" />
      <Folder Include="Authentication\Users\Queries\" />
      <Folder Include="Pathways\PatientPathwayStages\Definitions\" />
      <Folder Include="Pathways\PatientPathwayStages\Templates\" />
    </ItemGroup>

</Project>
